# 复制本文件为 .env.local 并填入真实账号/令牌；.env.local 已被 gitignore，切勿提交真实凭据。
# 环境域名类变量已在 .env.13 / .env.14 / .env.im 中预置，通常无需在此覆盖。

# 被测环境：13 | 14 | 15 | im | im2 | production（默认 13）
TEST_ENV=13

# ---- 主站 / 移动端（www*）----
WEB_HOST=https://www13.teacherin.vip
API_BASE_URL=https://www13.teacherin.vip/api/v1
WEB_BASE_URL=https://www13.teacherin.vip
MOBILE_BASE_URL=https://www13.teacherin.vip

# ---- 管理后台（zxjs*）----
ADMIN_HOST=https://zxjs13.teacherin.vip
ADMIN_BASE_URL=https://zxjs13.teacherin.vip
ADMIN_API_BASE_URL=https://zxjs13.teacherin.vip/api/v1

# ---- 鉴权（Gitea 风格 Bearer token）----
API_TOKEN=
# 兼容别名
TEST_TOKEN=
ADMIN_API_TOKEN=
MINIPROGRAM_TEST_TOKEN=

# ---- E2E 登录账号（可选）----
E2E_USERNAME=
E2E_PASSWORD=
ADMIN_E2E_USERNAME=
ADMIN_E2E_PASSWORD=
ACCOUNT_USER=
ACCOUNT_PASSWORD=

# UI 自动化步骤截图开关
E2E_STEP_SCREENSHOTS=0

# ---- 企微通知 ----
# WECOM_WEBHOOK_URL=
# WECOM_MENTION_MOBILES=
# WECOM_PUBLISH_WAIT_SECONDS=30

# ---- 报告发布 ----
# REPORT_PUBLISH_BASE_URL=
# REPORT_PUBLISH_GIT_REPO=
# REPORT_PUBLISH_GIT_TOKEN=

# ---- 小程序自动化（仅本地）----
# WX_DEVTOOLS_CLI=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
# MP_PROJECT=../teacherin-miniprogram/dist/build/mp-weixin
