# 复制为 .env 或 .env.13 / .env.14 / .env.im，按环境切换
ENV=13
BASE_URL=https://www13.teacherin.vip
API_BASE_URL=https://www13.teacherin.vip/api/v1
# 管理后台（zxjs 域名），默认按 ENV 映射 zxjs*；也可显式覆盖
# ADMIN_BASE_URL=https://zxjs13.teacherin.vip
# ADMIN_API_BASE_URL=https://zxjs13.teacherin.vip/api/v1
# Gitea 风格 token（Authorization: Bearer / token）
API_TOKEN=
# 测试账号
ACCOUNT_USER=
ACCOUNT_PASSWORD=
# 企业微信机器人（可选，失败告警）
WECOM_WEBHOOK=
