{
  "name": "teacherin-test-suite",
  "version": "0.1.0",
  "private": true,
  "description": "TeacherIn 统一测试套件：接口自动化、Web/H5 端到端、小程序自动化与性能压测",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "setup": "pnpm install && pnpm install:browsers",
    "postinstall": "node scripts/patch-reporter.mjs",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install --with-deps",
    "test": "playwright test",
    "test:api": "tsx scripts/run-api.ts",
    "test:core": "tsx scripts/run-api.ts --project core",
    "test:e2e:web": "tsx scripts/run-api.ts --project e2e-web",
    "test:e2e:mobile": "tsx scripts/run-api.ts --project e2e-mobile",
    "prepare:mp": "tsx scripts/prepare-miniprogram.ts",
    "test:mp": "tsx scripts/run-api.ts --project miniprogram",
    "report": "playwright show-report reports/latest/html",
    "report:enhanced": "node scripts/open-enhanced-report.mjs",
    "report:static": "node scripts/generate-static-report.mjs reports/latest/allure-results reports/latest/static-report",
    "report:allure": "allure generate reports/latest/allure-results --clean -o reports/latest/allure-html",
    "report:allure:open": "allure open reports/latest/allure-html",
    "perf:baseline": "k6 run perf/scenarios/api-baseline.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --import tsx --test scripts/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "miniprogram-automator": "^0.12.1",
    "patch-package": "^8.0.1",
    "playwright-enhanced-reporter": "3.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
